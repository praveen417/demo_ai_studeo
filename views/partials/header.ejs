<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b2a4a"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="apple-mobile-web-app-title" content="MBOP">
<link rel="manifest" href="/manifest.webmanifest"><link rel="icon" type="image/png" href="/static/icons/favicon-32.png">
<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
<title><%= typeof title !== 'undefined' ? title : 'MBOP' %> - MBOP Backup Reports</title>
<link rel="stylesheet" href="/static/style.css"></head><body class="nav-<%= nav_side %>">
<div class="top"><% if (user) { %><button class="menu-btn" type="button" data-menu-toggle aria-label="Menu">&#9776;</button><% } %><div class="brand">MBOP &middot; Backup Reports</div>
<div class="who"><button class="link" id="install-btn" type="button" hidden>Install app</button><% if (user) { %><a href="/account/password" style="color:#c9d6e6"><%= user.username %><span class="role"> (<%= user.role %>)</span></a>
<form method="post" action="/logout"><%- csrfInput() %><button class="link">Sign out</button></form><% } else { %><a href="/login" style="color:#c9d6e6">Login</a><% } %></div></div>
<div class="layout">
<div class="wrap content">
<% for (const msg of consumeFlashes()) { %><div class="flash <%= msg.cat %>"><%= msg.text %></div><% } %>
