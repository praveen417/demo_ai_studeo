# Server & Security
PORT=3000
SECRET_KEY=
INGEST_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=
COOKIE_SECURE=0
SESSION_HOURS=8
MAX_UPLOAD_MB=20
NAV_SIDE=right
TZ=Africa/Lusaka

# Database (unused in-memory mode; retained for reference)
MBOP_DB=/data/mbop.db

# KPI & Storage Thresholds
KPI_SUCCESS_TARGET=98
STORAGE_WARN_PCT=80
STORAGE_CRIT_PCT=90

# Mail & Scheduling
SMTP_SERVER=
SMTP_PORT=25
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
MAIL_FROM=
PORTAL_BASE_URL=
MONTHLY_MAIL_DAY=1
MONTHLY_MAIL_TIME=08:00
WEEKLY_MAIL_DAY=1
WEEKLY_MAIL_TIME=08:00
MAIL_SCHEDULER=1
APPROVAL_LINK_DAYS=14

# Tape Media
TAPE_DATE_ORDER=dmy
TAPE_FREE_FROM=2025-01-01
TAPE_FREE_COUNT_NEW=1
TAPE_SCRATCH_MIN=20
TAPE_SCRATCH_MIN_MAP=
TAPE_CHECK_TIME=08:00
TAPE_ALERT_ALWAYS=0
TAPE_STALE_DAYS=2
TAPE_TYPE_MAP=
TAPE_TABLE_DATES=created,assigned,first_mount,last_mount,expires
TAPE_BUFFER_PCT=10
TAPE_REUSE_PCT=90
TAPE_GROWTH_PCT=

# E-mail Follow-up (IMAP)
FOLLOWUP_ENABLED=0
FOLLOWUP_MAILBOX=netbackup-tickets@mtn.com
FOLLOWUP_POLL_SECONDS=120
FOLLOWUP_LOOKBACK_DAYS=90
FOLLOWUP_ACK=1
IMAP_HOST=
IMAP_PORT=0
IMAP_SECURITY=ssl
IMAP_USER=
IMAP_PASSWORD=
IMAP_PASSWORD_FILE=
IMAP_FOLDER=INBOX

# WhatsApp Cloud API
WHATSAPP_ENABLED=0
WHATSAPP_API_BASE=https://graph.facebook.com
